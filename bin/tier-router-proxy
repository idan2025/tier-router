#!/bin/bash
# tier-router-proxy: run Claude Code with tev1 picking Haiku, Sonnet or Opus per prompt.
#
#   tier-router-proxy claude [claude args…]   start the proxy if needed, run Claude Code through it
#   tier-router-proxy start | stop | status
#   tier-router-proxy log [n]                 the last n routing decisions (default 20)
#
# Env: TIER_ROUTER_PORT (8787), TIER_ROUTER_HAIKU/SONNET/OPUS (model ids),
#      TIER_ROUTER_HYSTERESIS (0.03), OLLAMA_HOST.
set -euo pipefail
HOME_DIR="${TIER_ROUTER_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
PORT="${TIER_ROUTER_PORT:-8787}"
STATE="$HOME/.cache/tier-router"
LOG="${TIER_ROUTER_LOG:-$STATE/decisions.jsonl}"
mkdir -p "$STATE"

running() { timeout 1 bash -c "exec 3<>/dev/tcp/127.0.0.1/$PORT" 2>/dev/null; }

start() {
    if running; then return 0; fi
    # Fully detached, so nothing that ran this waits on the proxy.
    (cd "$HOME_DIR" && TIER_ROUTER_PORT="$PORT" setsid -f python3 -s -m tier_router.proxy --port "$PORT" \
        </dev/null >>"$STATE/proxy.log" 2>&1)
    for _ in $(seq 1 150); do running && return 0; sleep 0.2; done
    echo "tier-router: the proxy did not start; see $STATE/proxy.log" >&2
    return 1
}

case "${1:-claude}" in
    start) start && echo "tier-router on http://127.0.0.1:$PORT" ;;
    stop)
        if pkill -f "[t]ier_router[.]proxy --port $PORT"; then echo "stopped"; else echo "not running"; fi
        rm -f "$STATE/proxy.pid" ;;
    status) if running; then echo "running on port $PORT"; else echo "not running"; fi ;;
    log)
        tail -n "${2:-20}" "$LOG" 2>/dev/null | python3 -I -c '
import json, sys, time
for l in sys.stdin:
    e = json.loads(l)
    if e.get("why") == "background": continue
    t = time.strftime("%H:%M:%S", time.localtime(e["t"]))
    tier = e.get("tier", "-")
    s = e.get("score"); s = f"{s:.2f}" if s is not None else "  - "
    extra = " (retried after %s)" % e["retried"] if "retried" in e else ""
    print("%s %-6s %s %-26s %r%s" % (t, tier, s, e.get("why", ""), e.get("prompt", "")[:70], extra))
' ;;
    claude)
        shift || true
        start
        ANTHROPIC_BASE_URL="http://127.0.0.1:$PORT" exec claude "$@" ;;
    *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
